# Copy to secrets.yaml (git-ignored) and fill in.
wifi_ssid: "your-wifi"
wifi_password: "your-wifi-password"

# Per device: "<device>__<name>", the format the ESPHome app uses for scoped secrets.
projector__fallback_ap_password: "change-me-12345"
# Generate with: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# The key is the whole output, 44 characters ending in "=".
projector__api_key: "PASTE_GENERATED_KEY_HERE"
